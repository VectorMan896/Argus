<?xml version="1.0" encoding="utf-8"?>
<!-- Project-local package source so a fresh clone (or CI) restores without any machine-wide NuGet setup. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
